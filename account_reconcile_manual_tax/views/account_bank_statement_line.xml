<data>
    <record id="bank_statement_line_form_reconcile_view" model="ir.ui.view">
        <field name="model">account.bank.statement.line</field>
        <field
            name="inherit_id"
            ref="account_reconcile_oca.bank_statement_line_form_reconcile_view"
        />
        <field name="arch" type="xml">
            <field name="analytic_distribution" position="after">
                <field
                    name="manual_tax_ids"
                    widget="many2many_tags"
                    attrs="{'readonly': ['|', '|', '|', ('manual_exchange_counterpart', '=', True),('manual_reference', '=', False), ('is_reconciled', '=', True), ('manual_line_id', '!=', False)], 'invisible': [('manual_kind', 'in', ['tax', 'liquidity'])]}"
                />
            </field>
        </field>
    </record>
</data>
