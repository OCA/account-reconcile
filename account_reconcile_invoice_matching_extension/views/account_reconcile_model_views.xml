<odoo>
    <record id="view_account_reconcile_model_form_inherit" model="ir.ui.view">
        <field name="name">account.reconcile.model.form.inherit</field>
        <field name="model">account.reconcile.model</field>
        <field name="inherit_id" ref="account.view_account_reconcile_model_form" />
        <field name="arch" type="xml">
            <field name="rule_type" position="after">
                <field name="invoice_payment_term_id" attrs="{'invisible': [('rule_type', '!=', 'invoice_matching')]}"/>
            </field>
            <xpath expr="//field[@name='match_total_amount']/.." position="after">
                <label for="match_total_amount_exact" attrs="{'invisible': [('rule_type', '!=', 'invoice_matching')]}"/>
                <div attrs="{'invisible': [('rule_type', '!=', 'invoice_matching')]}">
                    <field name="match_total_amount_exact"/>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
