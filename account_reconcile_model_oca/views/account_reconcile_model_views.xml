<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_account_reconcile_model_form" model="ir.ui.view">
        <field name="name">account.reconcile.model.form</field>
        <field name="model">account.reconcile.model</field>
        <field name="inherit_id" ref="account.view_account_reconcile_model_form" />
        <field name="arch" type="xml">
            <field name="active" position="after">
                <field name="payment_tolerance_param" invisible="1" />
                <field name="show_decimal_separator" invisible="1" />
            </field>
            <div class="oe_title" position="after">
                <group>
                    <group id="rule_left_column">
                        <field name="rule_type" widget="radio" />
                        <field
                            name="counterpart_type"
                            required="rule_type == 'writeoff_button'"
                            invisible="rule_type != 'writeoff_button'"
                        />
                        <field
                            name="auto_reconcile"
                            invisible="rule_type == 'writeoff_button'"
                        />
                        <field
                            name="to_check"
                            invisible="rule_type != 'writeoff_button'"
                        />
                    </group>
                    <group id="rule_right_column">
                        <field
                            name="matching_order"
                            invisible="rule_type != 'invoice_matching'"
                        />
                        <field
                            name="past_months_limit"
                            invisible="rule_type != 'invoice_matching'"
                        />
                        <field
                            name="decimal_separator"
                            invisible="not show_decimal_separator"
                        />
                    </group>
                </group>
            </div>
            <group id="filters_left_column" position="inside">
                <field name="match_nature" invisible="rule_type == 'writeoff_button'" />
                <label for="match_note" invisible="rule_type == 'writeoff_button'" />
                <div
                    class="d-flex gap-3"
                    invisible="rule_type == 'writeoff_button'"
                >
                    <field name="match_note" placeholder="Any note" />
                    <field
                        name="match_note_param"
                        invisible="not match_note"
                        required="match_note"
                    />
                </div>
                <label
                    for="match_transaction_type"
                    invisible="rule_type == 'writeoff_button'"
                />
                <div
                    class="d-flex gap-3"
                    invisible="rule_type == 'writeoff_button'"
                >
                    <field
                        name="match_transaction_type"
                        placeholder="Any transaction type"
                    />
                    <field
                        name="match_transaction_type_param"
                        invisible="not match_transaction_type"
                        required="match_transaction_type"
                    />
                </div>
                <field
                    name="match_partner"
                    invisible="rule_type == 'writeoff_button'"
                />
                <field
                    name="match_partner_category_ids"
                    widget="many2many_tags"
                    options="{'no_quick_create': True}"
                    placeholder="All categories"
                    invisible="rule_type == 'writeoff_button'"
                />
            </group>
            <group id="counterpart_entry_right_column" position="inside">
                <field
                    name="match_same_currency"
                    invisible="rule_type != 'invoice_matching'"
                />
                <label
                    for="allow_payment_tolerance"
                    invisible="rule_type != 'invoice_matching'"
                />
                <div
                    class="d-flex gap-2"
                    invisible="rule_type != 'invoice_matching'"
                >
                    <field name="allow_payment_tolerance" />
                    <span
                        invisible="not allow_payment_tolerance"
                        class="d-flex gap-2 w-100"
                    >
                        <field name="payment_tolerance_param" />
                        <field name="payment_tolerance_type" />
                    </span>
                </div>
                <field
                    name="match_text_location_label"
                    invisible="rule_type != 'invoice_matching'"
                />
                <field
                    name="match_text_location_note"
                    invisible="rule_type != 'invoice_matching'"
                />
                <field
                    name="match_text_location_reference"
                    invisible="rule_type != 'invoice_matching'"
                />
                <field
                    name="unique_matching"
                    invisible="rule_type != 'invoice_matching'"
                />
            </group>
            <xpath
                expr="//field[@name='line_ids']/list/field[@name='tax_ids']"
                position="after"
            >
                <field name="show_force_tax_included" column_invisible="True" />
                <field
                    name="force_tax_included"
                    invisible="not show_force_tax_included"
                    force_save="1"
                    optional="hide"
                />
                <field name="journal_id" optional="hide" />
            </xpath>
            <page id="counterpart_items_tab" position="after">
                <page
                    id="partner_mapping_tab"
                    string="Partner Mapping"
                    name="partner_mapping"
                    invisible="rule_type == 'writeoff_button'"
                >
                    <field name="partner_mapping_line_ids" nolabel="1">
                        <list editable="bottom">
                            <field name="partner_id" />
                            <field name="payment_ref_regex" />
                            <field name="narration_regex" />
                        </list>
                    </field>
                </page>
            </page>
        </field>
    </record>
</odoo>
