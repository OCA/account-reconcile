<odoo>
    <record id="view_account_journal_form" model="ir.ui.view">
        <field name="model">account.journal</field>
        <field
            name="inherit_id"
            ref="account_reconcile_oca.view_account_journal_form"
        />
        <field name="arch" type="xml">
            <field name="reconcile_mode" position="after">
                <field
                    name="bank_reconcile_account_allowed_ids"
                    widget="many2many_tags"
                    invisible="type != 'bank'"
                />
                <field name="search_limit_days" invisible="type != 'bank'" />
            </field>
        </field>
    </record>
</odoo>
